          "origin_index": 0
        }
      ]
    },
    {
      "kind": "update",
      "entity_type": "narrative",
      "value": {
        "body": "1457년 영월에 유배된 단종은 그곳에서 죽임을 당했다.",
        "kind": "primary",
        "title": "유배지에서의 죽음",
        "locale": "ko",
        "canon_id": "01a0c40a-a761-73d7-a8d2-fb4cddb6fd57",
