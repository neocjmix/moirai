    {
      "kind": "update",
      "entity_type": "narrative",
      "value": {
        "body": "1457년 단종은 노산군으로 강등되어 영월로 유배되었다. 1455년 왕위 상실에 이어 신분과 거처가 다시 바뀌었다.",
        "kind": "primary",
        "title": "노산군 강등과 영월 유배",
        "locale": "ko",
        "canon_id": "01a0c40a-a761-73d7-a8d2-fb4cddb6fd57",
        "scope_id": "019f5b00-0000-7000-8000-000000000119",
        "scope_type": "event",
