        "narrative_id": "019f60ab-0000-7000-8000-000000000301"
      },
      "origin_refs": [
        {
          "field": "*",
          "origin_index": 0
        }
      ]
    },
    {
      "kind": "update",
      "entity_type": "narrative",
      "value": {
        "body": "실록의 세종 25년 음력 12월 기록은 문자 28자의 창제를 전한다. 문자의 창제는 1446년 해설서 완성보다 앞선 사건이다.",
        "kind": "primary",
        "title": "문자 28자의 창제",
        "locale": "ko",
        "canon_id": "019f5b00-0000-7000-8000-000000000002",
        "scope_id": "019f60ab-0000-7000-8000-000000000102",
        "scope_type": "event",
        "public_references": [
          {
            "url": "https://www.korean.go.kr/hangeul/origin/001.html",
            "label": "국립국어원 — 훈민정음 기록과 한글날"
