# Runtime metadata; use explicit public placeholders only.
APP_VERSION=0.0.0
DEPLOY_COMMIT_SHA=0000000000000000000000000000000000000000
DEPLOYED_AT=1970-01-01T00:00:00.000Z

# Private runtime only. Never expose or commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# API only: empty credential allowlist is fail-closed. Provision hashes through Railway.
CLOTHO_CREDENTIALS_JSON=[]
# CLI only: inject the raw token from a secret store, never into Atropos.
CLOTHO_API_URL=https://LACHESIS_PUBLIC_HOST
CLOTHO_TOKEN=INJECT_FROM_SECRET_STORE
