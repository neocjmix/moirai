{
  "name": "@moirai/graph-presentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./src/artifacts.ts",
      "import": "./dist/artifacts.js"
    },
    "./layout-engine": {
      "types": "./src/layout-engine.ts",
      "import": "./dist/layout-engine.js"
    },
    "./composite-padding-profile": {
      "types": "./src/composite-padding-profile.ts",
      "import": "./dist/composite-padding-profile.js"
    },
    "./render-primitive-admission": {
      "types": "./src/render-primitive-admission.ts",
      "import": "./dist/render-primitive-admission.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moirai/contracts": "workspace:*",
    "@moirai/domain": "workspace:*",
    "@moirai/graph-query": "workspace:*",
    "@moirai/publication": "workspace:*",
    "@moirai/projections": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
