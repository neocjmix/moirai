    },
    {
      "kind": "update",
      "entity_type": "narrative",
      "value": {
        "body": "1456년 성삼문 등을 중심으로 한 단종 복위 계획이 발각되어 관련자들이 처형되었다. 같은 해 집현전도 폐지되었다.",
        "kind": "primary",
        "title": "복위 시도와 탄압의 확대",
        "locale": "ko",
        "canon_id": "01a0c40a-a761-73d7-a8d2-fb4cddb6fd57",
        "scope_id": "019f5b00-0000-7000-8000-000000000117",
