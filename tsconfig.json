{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@moirai/contracts": ["./packages/contracts/src/index.ts"],
      "@moirai/contracts/legacy-v4": ["./packages/contracts/src/legacy-v4.ts"],
      "@moirai/contracts/testing": ["./packages/contracts/src/testing.ts"],
      "@moirai/domain": ["./packages/domain/src/index.ts"],
      "@moirai/persistence": ["./packages/persistence/src/index.ts"],
      "@moirai/projections": ["./packages/projections/src/index.ts"],
      "@moirai/publication": ["./packages/publication/src/index.ts"],
      "@moirai/contracts/v5": ["./packages/contracts/src/v5.ts"],
      "@moirai/domain/v5": ["./packages/domain/src/v5.ts"],
      "@moirai/domain/v5-operations": ["./packages/domain/src/v5-operations.ts"]
    }
  },
  "include": ["*.ts", "scripts/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
